# OpenMontage relay configuration used by the case-study integration.
# Copy relevant values into /Users/bubu/Documents/projects/OpenMontage/.env.
# Do not commit real keys.

# GPT Image 2
OPENAI_API_KEY=
OPENAI_BASE_URL=https://us.tonbirds.com/v1
OPENAI_IMAGE_BASE_URL=https://us.tonbirds.com/v1
OPENAI_IMAGE_MODEL=gpt-image-2

# Grok video
XAI_API_KEY=
GROK_BASE_URL=https://yunwu.ai
XAI_BASE_URL=
GROK_VIDEO_MODEL=grok-imagine-video
GROK_VIDEO_CREATE_PATH=/v1/videos/generations
GROK_VIDEO_STATUS_PATH_TEMPLATE=/v1/videos/{request_id}

# MiniMax TTS
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://yunwu.ai/minimax
MINIMAX_GROUP_ID=
MINIMAX_TTS_MODEL=speech-2.8-turbo
MINIMAX_TTS_VOICE_ID=male-qn-badao
