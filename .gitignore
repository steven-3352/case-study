.venv/
.env
.env.*
!.env.example
ops/logs/
ops/platform_sessions/
out/_seg/
out/_*.png
*.mp3
*.aiff
*.m4a
*.wav
.DS_Store
__pycache__/
pipeline/**/.voice_chunks/

# 配音合成产物（可 regen）
pipeline/**/speech*.mp3
pipeline/**/*.tts.yaml

# 图片/视频成品不入库(体积大,可由 build_*.py 重新生成)
*.png
*.jpg
*.jpeg
*.webp
*.gif
*.mp4
*.mov
*.webm
*.m4v

# 通用产线工作区：克隆的外部仓库、渲染中间文件不入库
projects/*/repo/
projects/*/out/
projects/*/assets/
pipeline/**/out/
publish/.staging/
**/_tmp/

# tmp/ 研究临时目录 — clone 的 upstream repo · 抽帧 jpg · 分析中间产物(可能 500M+)
tmp/

# publish/ 整个目录不进仓库 — 成片/素材/制作过程文档全属本地产物（2026-07-22 用户拍板）
publish/

# agent 本地运行工作区(含 .venv / 大文件产物) — 未来 mv-agent-runs 也放这里
ad-agent-runs/
mv-agent-runs/

# 字体二进制不入库（~55MB，可由 assets/fonts/fetch_fonts.py 重新下载）
assets/fonts/*.ttf
assets/fonts/*.otf
assets/fonts/*.ttc
.cache/

# 多租户鉴权库 — 运行期产物，绝不入库（含用户密码 scrypt 哈希 / 会话 token）
auth.sqlite3
*.sqlite3
*.sqlite3-shm
*.sqlite3-wal
