# ad-agent · API Key 模板 —— 复制成 .env 后填写，不要提交 .env

# 文本分析（01 需求分析 / 02 分镜）
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# 图像生成（03 首帧 / 展示帧背景）
GPT_IMAGE_BASE_URL=
GPT_IMAGE_API_KEY=
GPT_IMAGE_MODEL=
GPT_IMAGE_QUALITY=high

# 视频生成（04 生成镜 / i2v 展示镜 · 本地 static/ken_burns 镜不需要）
SEEDANCE_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL=

# 可选：ffmpeg / ffprobe 路径（不填则用系统 PATH）
MVSTUDIO_FFMPEG_PATH=
MVSTUDIO_FFPROBE_PATH=
