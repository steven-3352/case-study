# ====================================================
# MV 导演助手 · 环境变量配置
# ====================================================
# 使用说明：
#   1. 复制本文件为 .env（不要提交到 Git）
#   2. 填入你的 API Key
#   3. 变量名遵循 mv_platform.application.control_plane.ENV_MAP
# ====================================================

# ---- 语言模型（LLM）----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=gpt-4-turbo
# WHISPER_MODEL 不用填：歌词对齐走本地 faster-whisper medium
# （setup 已下载到 ~/.local/share/mvstudio/models/，自动发现）
WHISPER_MODEL=

# ---- 图像生成 ----
GPT_IMAGE_BASE_URL=
GPT_IMAGE_API_KEY=
GPT_IMAGE_MODEL=gpt-image-2

# ---- 视频生成（Seedance）----
SEEDANCE_BASE_URL=
SEEDANCE_API_KEY=
SEEDANCE_MODEL=doubao-seedance-2-0

# ---- 可选：本地工具路径 ----
MVSTUDIO_FFMPEG_PATH=
MVSTUDIO_FFPROBE_PATH=
# 仅当想用自己下载的其它 whisper 模型时才填；留空则用 setup 下载的 medium（自动发现）
MVSTUDIO_WHISPER_MODEL=

# ---- 邀请码（固定值）----
MVSTUDIO_INVITE_CODE=jenny
