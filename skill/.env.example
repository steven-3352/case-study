# Tonbirds-Content-Engine-Plugin · API Key 配置模板
# 复制本文件为 .env，填入真实值后用 --env ./.env 指定（或 export 到环境变量）
# 不同 cap 按需填对应段，不用的 cap 留空即可。

# ─────────────────────────────────────────
# cap-stock-footage · 免费素材库(Pexels)
# 申请地址: https://www.pexels.com/api/ (免费 · 200 req/h)
# ─────────────────────────────────────────
PEXELS_API_KEY=

# ─────────────────────────────────────────
# cap-video-i2v · 图/文生视频(Seedance)
# 中转地址通常为 doubao/云雾中转，和项目保持一致
# ─────────────────────────────────────────
SEEDANCE_API_KEY=
SEEDANCE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
SEEDANCE_MODEL=doubao-seedance-2-0
# SEEDANCE_WORKERS=2   # 可选，默认2

# ─────────────────────────────────────────
# cap-tts · 语音合成
# provider 在 cap-tts/config.yaml 的 provider: 字段切换
# edge provider 无需 key（edge-tts 本地，免费保底）
# ─────────────────────────────────────────

# MiniMax 海螺（自然音，推荐）
# 中转注意：BASE_URL 可能需要带 /minimax 前缀，对照项目 .env.example
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimax.chat/v1
MINIMAX_GROUP_ID=         # 部分中转需要，可选

# 火山 / 豆包（volcengine）
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
# VOLC_TTS_BASE_URL=    # 可选，走默认端点

# ─────────────────────────────────────────
# cap-image-gen · 通用出图(GPT-image-2)
# 中转：tonbirds / 其他 OpenAI 兼容中转
# ─────────────────────────────────────────
GPT_IMAGE_API_KEY=
GPT_IMAGE_BASE_URL=https://us.tonbirds.com/v1
GPT_IMAGE_MODEL=gpt-image-2
# GPT_IMAGE_WORKERS=2   # 可选，默认2
