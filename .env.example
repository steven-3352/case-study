# 复制为 .env 并填入真实值（.env 不入库）
# cp .env.example .env
#
# 三方中转站：每个服务填 KEY + BASE_URL（根地址，不要带具体 path）
# 例 MiniMax 官方：MINIMAX_BASE_URL=https://api.minimaxi.com
# 例 云雾中转：MINIMAX_BASE_URL=https://yunwu.ai/minimax
# 例 Claude：ANTHROPIC_BASE_URL=https://你的中转域名/v1

# ── MiniMax TTS（pipeline/tts · speech-2.8-turbo）──
MINIMAX_API_KEY=
MINIMAX_BASE_URL=
MINIMAX_GROUP_ID=

# ── 火山 / 豆包 TTS（可选，provider: volcengine）──
VOLC_TTS_APPID=
VOLC_TTS_TOKEN=
VOLC_TTS_BASE_URL=

# ── Claude 创意核心（pipeline/author.py）──
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=

# ── OpenAI / GPT-image-2 图像（projects 子项目、报纸风出图）──
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_IMAGE_MODEL=gpt-image-2
# 部分中转用独立变量名（与 OPENAI_* 二选一即可）
GPT_IMAGE_API_KEY=
GPT_IMAGE_BASE_URL=
GPT_IMAGE_MODEL=gpt-image-2

# ── Pexels Videos · b-roll 拉取（pipeline/p004_video/fetch_broll.py）──
PEXELS_API_KEY=6fvnSYGxAdDpO2MGerrxTxkeuhTh8SrBiRAe39cV9ovhtbjsvMgikSr6

# ── Freesound · CC0 音效拉取（pipeline/sfx/fetch_sfx.py）──
# 注册: https://freesound.org/apiv2/apply/ （免费 · Token 认证即可）
FREESOUND_API_KEY=OMOcQ1PYhjq95bor4vPIevqqHyY7AFKs2KiNutzt

PIXABAY_API_KEY=56556243-dbbfbbc28c0c2324e465900ea

